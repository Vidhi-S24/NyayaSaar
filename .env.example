# ============================================================
# NyayaSaar — Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.
# Never commit .env — it is git-ignored.
# Values prefixed NEXT_PUBLIC_ are exposed to the browser bundle.
# All other values are server-side only.

# ------------------------------------------------------------
# Frontend (apps/web) — Next.js
# ------------------------------------------------------------

# Base URL of the FastAPI backend (no trailing slash)
# Local dev: http://localhost:8000
# Render: https://your-api-name.onrender.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ------------------------------------------------------------
# Backend (apps/api) — FastAPI
# ------------------------------------------------------------

# Application settings
APP_ENV=development          # development | staging | production
APP_SECRET_KEY=change-me-use-a-random-32-char-hex-string
LOG_LEVEL=INFO

# CORS — comma-separated list of allowed frontend origins
# Local dev: http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ------------------------------------------------------------
# Google Gemini AI
# ------------------------------------------------------------

# Your Google AI Studio / Vertex AI API key (server-side only)
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini model ID — configurable without code changes
GEMINI_MODEL_ID=gemini-2.0-flash-001

# ------------------------------------------------------------
# PostgreSQL (primary data store)
# ------------------------------------------------------------

DATABASE_URL=postgresql+asyncpg://nyayasaar:password@localhost:5432/nyayasaar_dev
# Sync URL for Alembic migrations
DATABASE_SYNC_URL=postgresql://nyayasaar:password@localhost:5432/nyayasaar_dev

# ------------------------------------------------------------
# Redis (optional — required for background jobs)
# ------------------------------------------------------------

REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------
# Neo4j (optional — required for citation graph features)
# ------------------------------------------------------------

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

# ------------------------------------------------------------
# Storage
# ------------------------------------------------------------

# Local dev: leave blank or set to a local path
# Production: set to s3, gcs, or azure and provide credentials
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage

# S3-compatible object storage (if STORAGE_BACKEND=s3)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# AWS_S3_REGION=

# ------------------------------------------------------------
# LangSmith tracing (optional — for LangGraph observability)
# ------------------------------------------------------------

# LANGSMITH_API_KEY=your-langsmith-api-key
# LANGSMITH_PROJECT=nyayasaar
# LANGCHAIN_TRACING_V2=true

# ------------------------------------------------------------
# Upload / execution limits
# ------------------------------------------------------------

MAX_UPLOAD_SIZE_MB=50
MAX_DOCUMENTS_PER_CASE=100
AGENT_EXECUTION_TIMEOUT_S=120

