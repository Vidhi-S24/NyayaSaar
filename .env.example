# ============================================================
# NyayaSaar — Environment Variables
# ============================================================
# Copy this file to apps/api/.env for the backend (the API loads that path).
# Frontend values belong in apps/web/.env.local.
# Never commit .env — it is git-ignored.
# Values prefixed NEXT_PUBLIC_ are exposed to the browser bundle.
# All other values are server-side only.

# ------------------------------------------------------------
# Frontend (apps/web) — Next.js
# ------------------------------------------------------------

# Base URL of the FastAPI backend (no trailing slash)
# Local dev: http://localhost:8000
# Render: https://your-api-name.onrender.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ------------------------------------------------------------
# Backend (apps/api) — FastAPI
# ------------------------------------------------------------

# Application settings
APP_ENV=development          # development | staging | production
APP_SECRET_KEY=change-me-use-a-random-32-char-hex-string
LOG_LEVEL=INFO

# CORS — comma-separated list of allowed frontend origins
# Local dev: http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# In development, localhost/127.0.0.1 on any port is also allowed automatically
# (Next.js often starts on 3001+). In production, set an explicit regex if needed.
# CORS_ORIGIN_REGEX=

# ------------------------------------------------------------
# AI provider (server-side only — never expose these to the browser)
# ------------------------------------------------------------
# Provider/model changes require NO application-code changes.
#
#   AI_PROVIDER=gemini            → official Google Gen AI SDK (default)
#   AI_PROVIDER=openai            → OpenAI Chat Completions
#   AI_PROVIDER=openai_compatible → Groq, OpenRouter, Together, DeepSeek,
#                                   Ollama, LM Studio, Azure-compatible gateways
#   AI_PROVIDER=anthropic         → Anthropic Messages API
#   AI_PROVIDER=mock              → clearly-labelled development fixture
#
# If no key is configured outside production, the API automatically uses the
# labelled fixture and never claims that a model was called.
AI_PROVIDER=gemini
AI_MODEL=gemini-3.1-flash-lite
# Leave empty to use the clearly-labelled development fixture outside production.
# Set a real provider key to call an actual model.
AI_API_KEY=

# Required for openai_compatible; optional override for OpenAI/Anthropic
# gateways. Examples:
#   OpenAI:       https://api.openai.com/v1
#   Groq:         https://api.groq.com/openai/v1
#   OpenRouter:   https://openrouter.ai/api/v1
#   Ollama:       http://localhost:11434/v1
AI_BASE_URL=

# Bounded provider behaviour (seconds, retries, tokens)
AI_TIMEOUT_S=45
AI_MAX_RETRIES=2
AI_STRUCTURED_RETRIES=1
AI_TEMPERATURE=0.2
AI_MAX_OUTPUT_TOKENS=4096
# none | json_object | json_schema (OpenAI-compatible adapters)
AI_JSON_MODE=json_object
# Pass a native response schema to Gemini. Keep true for reliable JSON output;
# set false only if the chosen model does not support structured output.
AI_GEMINI_NATIVE_SCHEMA=true
# Allow the labelled fixture when no key is configured. Defaults to true
# outside production. Never enable fixture output in a real legal workflow.
# AI_ALLOW_MOCK=false

# Backwards-compatible Gemini variables (still supported when AI_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-3.1-flash-lite

# ------------------------------------------------------------
# PostgreSQL (primary data store)
# ------------------------------------------------------------

# Async URL used by the FastAPI application (asyncpg driver).
# If unset, the API falls back to a local SQLite file (apps/api/nyayasaar-dev.db)
# and auto-creates the schema on startup — convenient for development,
# not for production.
DATABASE_URL=postgresql+asyncpg://nyayasaar:password@localhost:5432/nyayasaar_dev
# Sync URL used by Alembic migrations (psycopg 3 driver).
DATABASE_SYNC_URL=postgresql+psycopg://nyayasaar:password@localhost:5432/nyayasaar_dev

# ------------------------------------------------------------
# Authentication (Stage 3)
# ------------------------------------------------------------

# Secret used to sign JWTs. Falls back to APP_SECRET_KEY if empty.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
# HS256 by default; 30-minute access tokens.
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Demo seed script defaults (python -m scripts.seed_demo) — development only.
DEMO_USER_EMAIL=demo@nyayasaar.example
DEMO_USER_PASSWORD=demo-password-123
DEMO_USER_NAME=Demo Advocate

# ------------------------------------------------------------
# Redis (optional — not used in Stage 5)
# ------------------------------------------------------------
# Stage 5 runs analysis as a bounded in-process background task.
# Set this only when a durable queue (Celery/Redis) is introduced.
REDIS_URL=

# ------------------------------------------------------------
# Neo4j (optional — required for citation graph features)
# ------------------------------------------------------------
# Leave blank unless you are running Neo4j.
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ------------------------------------------------------------
# Storage
# ------------------------------------------------------------

# Local dev: leave blank or set to a local path
# Production: set to s3, gcs, or azure and provide credentials
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage

# S3-compatible object storage (if STORAGE_BACKEND=s3)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# AWS_S3_REGION=

# ------------------------------------------------------------
# LangSmith tracing (optional — for LangGraph observability)
# ------------------------------------------------------------

# LANGSMITH_API_KEY=your-langsmith-api-key
# LANGSMITH_PROJECT=nyayasaar
# LANGCHAIN_TRACING_V2=true

# ------------------------------------------------------------
# Upload / execution limits
# ------------------------------------------------------------

MAX_UPLOAD_SIZE_MB=50
MAX_DOCUMENTS_PER_CASE=100
MAX_ANALYSIS_FOCUS_CHARS=1000

# Bounded agent workflow execution
AGENT_EXECUTION_TIMEOUT_S=120
# Stage 6 uses two specialist calls (extraction + evidence) plus one bounded
# verifier revision, so the default budget is 5 calls.
AGENT_MAX_LLM_CALLS=5
AGENT_MAX_INPUT_CHARS=24000
# Pages below this many characters are still analysed but flagged as short;
# runs whose total usable text is below it return an honest insufficient result.
AGENT_MIN_SOURCE_CHARS=40
AGENT_MAX_TOTAL_TOKENS=80000
AGENT_MAX_VERIFIER_RETRIES=1
AGENT_MAX_WORKFLOW_ATTEMPTS=2


# ------------------------------------------------------------
# Hybrid Legal Retrieval & Legal-Source Provider (Stage 7)
# ------------------------------------------------------------

# Embedding provider: hashing (offline deterministic) | gemini | openai | openai_compatible | none
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=
# Falls back to AI_API_KEY / GEMINI_API_KEY when empty
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_TIMEOUT_S=20
RETRIEVAL_EMBEDDINGS_ENABLED=true
# Must match the pgvector column dimension (256 in migration 005)
RETRIEVAL_EMBEDDING_DIM=256
RETRIEVAL_MAX_CANDIDATES=400
RETRIEVAL_DEFAULT_LIMIT=10
RETRIEVAL_MAX_LIMIT=50
RETRIEVAL_MAX_QUERY_CHARS=500
RETRIEVAL_RRF_K=60
RETRIEVAL_LEXICAL_WEIGHT=0.5
RETRIEVAL_SEMANTIC_WEIGHT=0.5
RETRIEVAL_RERANK_ENABLED=true

# Legal-source provider: none (development fixture only) | json | fixture
LEGAL_CORPUS_PROVIDER=none
LEGAL_CORPUS_PATH=
